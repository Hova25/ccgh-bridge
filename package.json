{
  "name": "ccgh-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ccgh": "./bin/ccgh"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "verify": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "astro": "^7.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
