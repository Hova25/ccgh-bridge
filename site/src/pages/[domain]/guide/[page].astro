---
import { getEntry, render } from "astro:content";
import Prose from "../../../components/Prose.astro";
import { leafOf, pathsFor, slugOf } from "../../../leaf";
import { breadcrumbFor } from "../../../../../src/docs/routes";
import { treeOf } from "../../../../../src/docs/tree";

export const getStaticPaths = () =>
  pathsFor({
    kind: "guide",
    params: (location) => ({ domain: location.domain, page: slugOf(location) }),
  });

const { file } = Astro.props;
const { entries, entry, currentUrl } = await leafOf({ file });
const tree = treeOf({ entries, currentUrl });

const { Content } = await render((await getEntry("guides", file.replace(/\.md$/, "")))!);
---

<Prose title={entry.data.title as string} meta={null} crumbs={breadcrumbFor(entry.location)} tree={tree}>
  <h1>{entry.data.title}</h1>
  <Content />
</Prose>
