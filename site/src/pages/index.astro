---
// A temporary page: task 5 replaces it with the real home page. It exists to prove the shell,
// the tree and the theme compile and render against a repository's own content.
import Shell from "../components/Shell.astro";
import Tree from "../components/Tree.astro";
import { treeOf } from "../../../src/docs/tree";
import { entriesOf } from "../entries";

const entries = await entriesOf();
const tree = treeOf({ entries, currentUrl: "/" });
---

<Shell title="Domains" crumbs={[{ label: "Home", href: "/" }]} tree={tree}>
  <Tree slot="tree" nodes={tree} />
  <h1>Domains</h1>
  <ul>
    {
      entries
        .filter((entry) => entry.location.kind === "domain")
        .map((entry) => (
          <li>
            <strong>{String(entry.data.title)}</strong> — {String(entry.data.summary)}
          </li>
        ))
    }
  </ul>
</Shell>
