---
import type { TreeNode } from "../../../src/docs/tree";

type Props = { nodes: TreeNode[]; level?: number };

const { nodes, level = 0 } = Astro.props;
---

<ul class:list={["tree", { nested: level > 0 }]}>
  {
    nodes.map((node) => (
      <li>
        {node.children.length > 0 ? (
          <details open={node.open}>
            <summary class:list={["row", "section", { group: node.href === null, current: node.current }]}>
              <span class="marker" aria-hidden="true" />
              {node.href === null ? (
                <span class="text" title={node.hint ?? node.label}>
                  {node.label}
                </span>
              ) : (
                <a
                  class="text"
                  href={node.href}
                  title={node.hint ?? node.label}
                  aria-current={node.current ? "page" : undefined}
                >
                  {node.label}
                </a>
              )}
              {node.badge && <span class="badge">{node.badge}</span>}
            </summary>
            <Astro.self nodes={node.children} level={level + 1} />
          </details>
        ) : (
          <a
            href={node.href}
            class:list={["row", "page", { current: node.current }]}
            aria-current={node.current ? "page" : undefined}
            title={node.hint ?? node.label}
          >
            <span class="text">{node.label}</span>
            {node.badge && <span class="badge">{node.badge}</span>}
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nested {
    margin-left: calc(var(--space) * 1.25);
    padding-left: calc(var(--space) * 1.25);
    border-left: 1px solid var(--rail);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space);
    min-height: var(--row-height);
    padding: 2px var(--space);
    margin: 1px 0;
    border-radius: var(--radius-row);
    color: var(--text-muted);
    text-decoration: none;
  }

  .row:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .section {
    cursor: pointer;
    color: var(--text-section);
    font-weight: 600;
    list-style: none;
  }

  .section::-webkit-details-marker {
    display: none;
  }

  .group {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .marker {
    flex: 0 0 auto;
    width: 0;
    height: 0;
    border-left: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.12s;
  }

  details[open] > .section .marker {
    transform: rotate(90deg);
  }

  .text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }

  .current {
    background: var(--surface-current);
    color: var(--text);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .badge {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    padding: 1px calc(var(--space) * 0.9);
    border-radius: 999px;
    background: var(--surface-raised);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .marker {
      transition: none;
    }
  }
</style>
