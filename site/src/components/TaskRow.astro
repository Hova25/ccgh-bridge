---
type Props = {
  order: number;
  title: string;
  href: string;
  issue: number | null;
  state: string | null;
  mergedAt: string | null;
};

const { order, title, href, issue, state, mergedAt } = Astro.props;

const label = issue === null ? "pending" : mergedAt ? "done" : (state ?? "open");
---

<li>
  <span class="order">{String(order).padStart(2, "0")}</span>
  <a class="title" href={href}>{title}</a>
  {issue !== null && <span class="issue">#{issue}</span>}
  <span class:list={["state", label]}>{label}</span>
</li>

<style>
  li {
    display: flex;
    gap: calc(var(--space) * 1.5);
    align-items: baseline;
    padding: 2px 0;
    max-width: var(--measure);
  }

  .order {
    color: var(--text-muted);
    width: 2ch;
    text-align: right;
  }

  .title {
    flex: 1;
    min-width: 0;
  }

  .issue {
    color: var(--text-muted);
  }

  .state {
    white-space: nowrap;
  }

  .done,
  .closed {
    color: var(--accent);
  }

  .open {
    color: var(--warn);
  }

  .pending {
    color: var(--text-muted);
  }
</style>
